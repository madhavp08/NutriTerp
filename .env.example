# Copy to .env and fill in real values. .env is git-ignored.
#
# DATABASE_URL steps:
#   1. Open https://console.neon.tech and sign in.
#   2. Open the nutriterp project (or create one, region aws-us-east-1).
#   3. Click Connect (or Dashboard -> Connection Details).
#   4. Choose "Pooled connection" and copy the URI.
#   5. Paste it below. Keep sslmode=require (Neon needs TLS).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Secret used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me
