# Copy to .env and fill in real values. .env is git-ignored.
# Get DATABASE_URL from https://console.neon.tech -> your project -> Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Secret used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me
